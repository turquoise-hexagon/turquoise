# Description : Change brightness via the command-line
# URL         : https://github.com/turquoise-hexagon/brightness
# Maintainer  : camille, camille at lzr dot pw
# Depends on  : docutils

name=brightness
version=git
release=5
source=()

download() {
    cd "$PKGMK_SOURCE_DIR"

    if [[ -d $name-$version ]]; then
        git -C "$name-$version" pull
    else
        git clone "$1" "$name-$version"
    fi
}
build() {
    download "https://github.com/turquoise-hexagon/$name"

    cd "$name-$version"

    make
    make DESTDIR="$PKG" install
}
