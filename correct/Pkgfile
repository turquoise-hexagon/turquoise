# Description : Correct a given string to a valid command
# URL         : https://github.com/turquoise-hexagon/correct
# Maintainer  : camille, camille at lzr dot pw
# Depends on  : docutils

name=correct
version=git
release=4
source=()

download() {
    cd "$PKGMK_SOURCE_DIR"

    if [[ -d $name-$version ]]; then
        git -C "$name-$version" pull
    else
        git clone "$1" "$name-$version"
    fi
}

build() {
    download "https://github.com/turquoise-hexagon/$name"

    cd "$name-$version"

    make
    make DESTDIR="$PKG" install
}
