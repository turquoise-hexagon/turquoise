# Description : A tiling window manager based on binary space partitioning
# URL         : https://github.com/baskerville/bspwm
# Maintainer  : camille, camille at lzr dot pw
# Depends on  : xorg-xcb-util xorg-xcb-util-keysyms xorg-xcb-util-wm

name=bspwm
version=git
release=3
source=()

download() {
    cd "$PKGMK_SOURCE_DIR"

    if [[ -d $name-$version ]]; then
        git -C "$name-$version" pull
    else
        git clone "$1" "$name-$version"
    fi
}

build() {
    download "https://github.com/baskerville/$name"

    cd "$name-$version"

    make
    make PREFIX=/usr DOCPREFIX="/usr/share/$name" DESTDIR="$PKG" install

    rm -rf "$PKG/usr/share/$name/"{examples,*.md}
}
