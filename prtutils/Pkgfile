# Description : Various ports scripts
# URL         : https://github.com/turquoise-hexagon/prtutils
# Maintainer  : camille, camille at lzr dot pw
# Depends on  : docutils

name=prtutils
version=git
release=12
source=()

download() {
    cd "$PKGMK_SOURCE_DIR"

    if [[ -d $name-$version ]]; then
        git -C "$name-$version" pull
    else
        git clone "$1" "$name-$version"
    fi
}

build() {
    download "https://github.com/turquoise-hexagon/$name"

    cd "$name-$version"

    make
    make DESTDIR="$PKG" install
}
