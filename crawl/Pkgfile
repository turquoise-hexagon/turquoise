# Description : Dungeon Crawl: Stone Soup
# URL         : https://crawl.develz.org
# Maintainer  : camille, camille at lzr dot pw
# Depends on  : advancecomp bison flex freetype glu libsdl2 lua lua51 ncurses python3-pyyaml sdl2_image sqlite3 xorg-font-dejavu-ttf

name=crawl
version=git
release=9
source=(makefile.patch)

download() {
    cd "$PKGMK_SOURCE_DIR"

    if [[ -d $name-$version ]]; then
        git -C "$name-$version" pull
    else
        git clone "$1" "$name-$version"
    fi
}

build() {
    download "https://github.com/$name/$name"

    cd "$name-$version"

    patch -p 1 -i "$SRC/makefile.patch"

    cd "$name-ref/source"

    make                           \
        DESTDIR="$PKG"             \
        DATADIR="/usr/share/$name" \
        SAVEDIR="~/.$name"         \
        USE_UNICODE=y              \
        TILES=y                    \
        install

    rm -rf "$PKG/usr/share/$name/dat/descript/"*/
}
