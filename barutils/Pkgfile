# Description : A set of utilities for lemonbar
# URL         : https://github.com/turquoise-hexagon/barutils
# Maintainer  : camille, camille at lzr dot pw

name=barutils
version=git
release=2
source=()

download() {
    cd "$PKGMK_SOURCE_DIR"

    if [[ -d $name-$version ]]; then
        git -C "$name-$version" pull
    else
        git clone "$1" "$name-$version"
    fi
}

build() {
    download "https://github.com/turquoise-hexagon/$name"

    cd "$name-$version"

    make
    make DESTDIR="$PKG" install
}
