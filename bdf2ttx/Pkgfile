# Description : convert BDF files to TTX
# URL         : https://github.com/turquoise-hexagon/bdf2ttx
# Maintainer  : camille, camille at lzr dot pw
# Depends on  : docutils chicken

name=bdf2ttx
version=git
release=3
source=()

download() {
    cd "$PKGMK_SOURCE_DIR"

    if [[ -d $name-$version ]]; then
        git -C "$name-$version" pull
    else
        git clone "$1" "$name-$version"
    fi
}

build() {
    download "https://github.com/turquoise-hexagon/$name"

    cd "$name-$version"

    make
    make DESTDIR="$PKG" install
}
